                    </div>

                    <!-- Feroz -->
                    <div class="shop-item">
                        <div class="tooltip">Tipo: Feroz<br>ATK: 2 | HP: 10 | Custo: 0</div>
                        <img src="ImagensPVZ/minions/cabra.png" alt="Cabra" class="item-img">
                        <h3 class="item-name">Cabra</h3>
                        <p class="item-price">$ 50</p>
                        <button class="buy-btn" onclick="comprarItem('Cabra', 50)">Recrutar</button>
                    </div>
                    <div class="shop-item">
                        <div class="tooltip">Tipo: Feroz<br>ATK: 2 | HP: 30 | Custo: 3</div>
                        <img src="ImagensPVZ/minions/planador_cabra_3000.png" alt="Planador Cabra 3000" class="item-img">
