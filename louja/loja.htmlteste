<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Bazar do Rux - Minions</title>
    <style>
        body {
            background-image: url('../ImagensPVZ/Cenários/rux.png');
            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;
            background-attachment: fixed;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            color: white;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            margin: 0;
        }

        .shop-container {
            padding: 20px;
            width: 95%;
            max-width: 1200px;
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .shop-container h2 {
            text-align: center;
            margin: 0;
            color: #f8e9a1;
            text-shadow: 2px 2px 4px #000;
            letter-spacing: 2px;
            background-color: rgba(0, 0, 0, 0.6);
            padding: 10px;
            border-radius: 10px;
            width: fit-content;
            margin: 0 auto;
        }

        .shop-container h3 {
            text-align: center;
            margin: 0 0 15px 0;
            color: #ffffff;
            font-size: 18px;
            text-shadow: 1px 1px 3px #000;
            background-color: rgba(139, 90, 43, 0.8);
            padding: 5px 20px;
            border-radius: 20px;
            width: fit-content;
            margin: 0 auto 15px auto;
            border: 1px solid #00cc00; /* Borda verde para diferenciar de itens */
        }

        /* Botão de voltar para o menu */
        .back-btn {
            position: absolute;
            top: 20px;
            left: 20px;
            background-color: #8b5a2b;
            color: white;
            text-decoration: none;
            padding: 10px 20px;
            border-radius: 5px;
            font-weight: bold;
            border: 2px solid #5c3a21;
            transition: 0.3s;
            z-index: 1000;
        }
        .back-btn:hover {
            background-color: #5c3a21;
        }

        .carousel-wrapper {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 15px;
        }

        .arrow-btn {
            background-color: #00cc00; /* Verde para pokemons */
            color: white;
            border: none;
            font-size: 26px;
            width: 50px;
            height: 50px;
            border-radius: 50%;
            cursor: pointer;
            display: flex;
            justify-content: center;
            align-items: center;
            transition: background 0.3s, transform 0.2s;
            flex-shrink: 0;
            box-shadow: 0 4px 10px rgba(0,0,0,0.5);
            z-index: 100;
        }

        .arrow-btn:hover {
            background-color: #009900;
            transform: scale(1.1);
        }

        .pages-container {
            flex-grow: 1;
            overflow: visible; 
        }

        .page {
            display: none;
        }

        .page.active {
            display: grid;
            grid-template-columns: repeat(5, 1fr);
            gap: 80px 15px; 
        }

        .shop-item {
            background-color: rgba(42, 42, 42, 0.8);
            border: 2px solid #00cc00; /* Borda verde */
            border-radius: 8px;
            padding: 12px;
            text-align: center;
            transition: transform 0.2s, box-shadow 0.2s;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            box-shadow: 0 5px 15px rgba(0,0,0,0.6);
            position: relative; 
        }

        .shop-item:hover {
            transform: translateY(-5px);
            box-shadow: 0 0 15px #00ff00;
            border-color: #00ff00;
            z-index: 10;
        }

        .tooltip {
            position: absolute;
            bottom: 105%;
            left: 50%;
            transform: translateX(-50%);
            background-color: rgba(20, 20, 20, 0.95);
            color: #fff;
            padding: 10px;
            border-radius: 8px;
            border: 2px solid #00cc00;
            width: max-content;
            max-width: 200px;
            text-align: center;
            font-size: 13px;
            line-height: 1.4;
            opacity: 0;
            visibility: hidden;
            transition: opacity 0.3s, visibility 0.3s, bottom 0.3s;
            box-shadow: 0 4px 15px rgba(0,0,0,0.8);
            pointer-events: none;
            z-index: 1000;
        }

        .tooltip::after {
            content: '';
            position: absolute;
            top: 100%;
            left: 50%;
            margin-left: -6px;
            border-width: 6px;
            border-style: solid;
            border-color: #00cc00 transparent transparent transparent;
        }

        .shop-item:hover .tooltip {
            opacity: 1;
            visibility: visible;
            bottom: 115%;
        }

        .item-img {
            width: 100%;
            height: 90px;
            object-fit: contain;
            background-color: #111;
            border-radius: 6px;
            margin-bottom: 8px;
            padding: 4px;
        }

        .item-name {
            font-size: 14px;
            margin: 4px 0;
            color: #fff;
            min-height: 34px; 
        }

        .item-price {
            color: #f8e9a1; /* Amarelo para pokemons */
            font-weight: bold;
            font-size: 15px;
            margin-bottom: 8px;
        }

        .buy-btn {
            background-color: #00cc00;
            color: white;
            border: none;
            padding: 8px;
            border-radius: 5px;
            font-weight: bold;
            font-size: 13px;
            cursor: pointer;
            text-transform: uppercase;
            transition: background 0.3s;
            width: 100%;
        }

        .buy-btn:hover {
            background-color: #009900;
        }

        .page-indicator {
            text-align: center;
            font-size: 15px;
            color: #f8e9a1;
            background-color: rgba(0, 0, 0, 0.6);
            padding: 5px 15px;
            border-radius: 20px;
            width: fit-content;
            margin: 0 auto;
        }

        @media (max-width: 900px) {
            .page.active {
                grid-template-columns: repeat(3, 1fr);
                gap: 60px 15px;
            }
        }
        @media (max-width: 600px) {
            .page.active {
                grid-template-columns: repeat(2, 1fr);
            }
            .arrow-btn {
                width: 40px;
                height: 40px;
                font-size: 20px;
            }
        }
    </style>
</head>
<body>

    <a href="lojainicial.html" class="back-btn">⬅ Voltar</a>

    <div class="shop-container">
        <h2>🧟‍♂️ Minions do Rux 🌻</h2>
