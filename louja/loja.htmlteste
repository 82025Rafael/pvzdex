                        <p class="item-price">$ 200</p>
                        <button class="buy-btn" onclick="comprarItem('Planador Cabra 3000', 200)">Recrutar</button>
                    </div>
                    <div class="shop-item">
                        <div class="tooltip">Tipo: Feroz<br>ATK: 10 | HP: 50 | Custo: 5</div>
                        <img src="ImagensPVZ/minions/brontaco.png" alt="Brontaço" class="item-img">
                        <h3 class="item-name">Brontaço</h3>
                        <p class="item-price">$ 300</p>
                        <button class="buy-btn" onclick="comprarItem('Brontaço', 300)">Recrutar</button>
                    </div>
                    <div class="shop-item">
                        <div class="tooltip">Tipo: Feroz<br>ATK: 4 | HP: 10 | Custo: 2</div>
                        <img src="ImagensPVZ/minions/zumbi_assombrado.png" alt="Zumbi Assombrado" class="item-img">
                        <h3 class="item-name">Zumbi Assombrado</h3>
                        <p class="item-price">$ 150</p>
                        <button class="buy-btn" onclick="comprarItem('Zumbi Assombrado', 150)">Recrutar</button>
                    </div>
                    <div class="shop-item">
                        <div class="tooltip">Tipo: Feroz<br>ATK: 6 | HP: 20 | Custo: 2</div>
                        <img src="ImagensPVZ/minions/cavaleiro_golfinho.png" alt="Cavaleiro do Golfinho" class="item-img">
                        <h3 class="item-name">Cavaleiro do Golfinho</h3>
                        <p class="item-price">$ 150</p>
                        <button class="buy-btn" onclick="comprarItem('Cavaleiro do Golfinho', 150)">Recrutar</button>
                    </div>
                </div>

                <!-- PÁGINA 5: Zumbis (Furtivo e Vigoroso) -->
                <div class="page">
                    <!-- Furtivo -->
                    <div class="shop-item">
                        <div class="tooltip">Tipo: Furtivo<br>ATK: 4 | HP: 20 | Custo: 2</div>
                        <img src="ImagensPVZ/minions/zumbinho_salsicha.png" alt="Zumbinho Salsicha" class="item-img">
                        <h3 class="item-name">Zumbinho Salsicha</h3>
                        <p class="item-price">$ 150</p>
                        <button class="buy-btn" onclick="comprarItem('Zumbinho Salsicha', 150)">Recrutar</button>
                    </div>
                    <div class="shop-item">
                        <div class="tooltip">Tipo: Furtivo<br>ATK: 4 | HP: 20 | Custo: 1</div>
                        <img src="ImagensPVZ/minions/galinha_zumbi.png" alt="Galinha Zumbi" class="item-img">
                        <h3 class="item-name">Galinha Zumbi</h3>
                        <p class="item-price">$ 100</p>
                        <button class="buy-btn" onclick="comprarItem('Galinha Zumbi', 100)">Recrutar</button>
                    </div>
                    <div class="shop-item">
                        <div class="tooltip">Tipo: Furtivo<br>ATK: 6 | HP: 10 | Custo: 2</div>
                        <img src="ImagensPVZ/minions/galo_de_fogo.png" alt="Galo de Fogo" class="item-img">
                        <h3 class="item-name">Galo de Fogo</h3>
                        <p class="item-price">$ 150</p>
                        <button class="buy-btn" onclick="comprarItem('Galo de Fogo', 150)">Recrutar</button>
                    </div>
                    <div class="shop-item">
                        <div class="tooltip">Tipo: Furtivo<br>ATK: 6 | HP: 40 | Custo: 5</div>
                        <img src="ImagensPVZ/minions/yeti_criogenico.png" alt="Yeti Criogênico" class="item-img">
                        <h3 class="item-name">Yeti Criogênico</h3>
                        <p class="item-price">$ 250</p>
                        <button class="buy-btn" onclick="comprarItem('Yeti Criogênico', 250)">Recrutar</button>
                    </div>
                    <div class="shop-item">
                        <div class="tooltip">Tipo: Furtivo<br>ATK: 10 | HP: 50 | Custo: 6</div>
                        <img src="ImagensPVZ/minions/zumbo_subtubarootronico.png" alt="Zumbô SubTubarôotrônico" class="item-img">
                        <h3 class="item-name">Zumbô SubTubarôotrônico</h3>
                        <p class="item-price">$ 300</p>
                        <button class="buy-btn" onclick="comprarItem('Zumbô SubTubarôotrônico', 300)">Recrutar</button>
                    </div>

                    <!-- Vigoroso -->
                    <div class="shop-item">
                        <div class="tooltip">Tipo: Vigoroso<br>ATK: 12 | HP: 10 | Custo: 7</div>
                        <img src="ImagensPVZ/minions/aspirante_a_heroi.png" alt="Aspirante a Herói" class="item-img">
                        <h3 class="item-name">Aspirante a Herói</h3>
                        <p class="item-price">$ 350</p>
                        <button class="buy-btn" onclick="comprarItem('Aspirante a Herói', 350)">Recrutar</button>
                    </div>
                    <div class="shop-item">
                        <div class="tooltip">Tipo: Vigoroso<br>ATK: 4 | HP: 30 | Custo: 2</div>
                        <img src="ImagensPVZ/minions/zumbi_sumo.png" alt="Zumbi Sumô" class="item-img">
                        <h3 class="item-name">Zumbi Sumô</h3>
                        <p class="item-price">$ 150</p>
                        <button class="buy-btn" onclick="comprarItem('Zumbi Sumô', 150)">Recrutar</button>
                    </div>
                    <div class="shop-item">
                        <div class="tooltip">Tipo: Vigoroso<br>ATK: 4 | HP: 20 | Custo: 3</div>
                        <img src="ImagensPVZ/minions/all_star_cosmico.png" alt="All-Star Cósmico" class="item-img">
                        <h3 class="item-name">All-Star Cósmico</h3>
                        <p class="item-price">$ 200</p>
                        <button class="buy-btn" onclick="comprarItem('All-Star Cósmico', 200)">Recrutar</button>
                    </div>
                    <div class="shop-item">
                        <div class="tooltip">Tipo: Vigoroso<br>ATK: 8 | HP: 60 | Custo: 6</div>
                        <img src="ImagensPVZ/minions/farao_imortal.png" alt="Faraó Imortal" class="item-img">
                        <h3 class="item-name">Faraó Imortal</h3>
                        <p class="item-price">$ 300</p>
                        <button class="buy-btn" onclick="comprarItem('Faraó Imortal', 300)">Recrutar</button>
                    </div>
                    <div class="shop-item">
                        <div class="tooltip">Tipo: Vigoroso<br>ATK: 2 | HP: 40 | Custo: 3</div>
                        <img src="ImagensPVZ/minions/zumbi_mascote_de_time.png" alt="Zumbi Mascote de Time" class="item-img">
                        <h3 class="item-name">Zumbi Mascote de Time</h3>
                        <p class="item-price">$ 200</p>
                        <button class="buy-btn" onclick="comprarItem('Zumbi Mascote de Time', 200)">Recrutar</button>
                    </div>
                </div>

            </div>

            <button class="arrow-btn" onclick="changePage(1)">&#10095;</button>
        </div>

        <div class="page-indicator">
            Página <span id="current-page">1</span> de 5
        </div>
    </div>

    <script>
        let currentPageIndex = 0;
        const pages = document.querySelectorAll('.page');
        const pageIndicator = document.getElementById('current-page');
        const categoryTitle = document.getElementById('category-title');
        
        // Títulos para cada página de pokémons
        const titles = [
            "Plantas - Explosivo & Crescida",
            "Plantas - Esperto & Protetor",
            "Plantas (Solar) & Zumbis (Miolástico)",
            "Zumbis - Doidão & Feroz",
            "Zumbis - Furtivo & Vigoroso"
        ];

        function changePage(direction) {
            pages[currentPageIndex].classList.remove('active');
            currentPageIndex += direction;

            if (currentPageIndex >= pages.length) {
                currentPageIndex = 0;
            } else if (currentPageIndex < 0) {
                currentPageIndex = pages.length - 1;
            }

            pages[currentPageIndex].classList.add('active');
            pageIndicator.innerText = currentPageIndex + 1;
            
            // Atualiza o título
            categoryTitle.innerText = titles[currentPageIndex];
        }

        function comprarItem(nome, preco) {
            alert(`Você recrutou: ${nome}\nCusto: $${preco}`);
        }
    </script>

</body>
</html>